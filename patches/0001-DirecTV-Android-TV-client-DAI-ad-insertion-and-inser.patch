+@sources_bp.route('/sources/<int:source_id>/directv-logout', methods=['POST'])
+def directv_logout(source_id):
+    """Sign the DirecTV source out: clear the stored Android TV session (bearer, refresh,
+    activation, device id, DAI targeting) and the cached Yospace playback URLs, so the
+    source reads as not-authenticated and the next Authenticate is a fresh grant."""
+    from ..extensions import db
+    from ..models import SourceCache
+
+    source = Source.query.get_or_404(source_id)
+    if source.name != 'directv':
+        return jsonify({'error': 'not a directv source'}), 400
+
+    cfg = dict(source.config or {})
+    for key in _DIRECTV_SESSION_KEYS:
+        cfg.pop(key, None)
+    source.config = cfg
+    SourceCache.query.filter_by(source_id=source_id, cache_key='directv_playback').delete()
+    db.session.commit()
+    return jsonify({'status': 'logged_out'})
+
+
+@sources_bp.route('/sources/<int:source_id>/directv-profile', methods=['GET', 'POST'])
+def directv_profile(source_id):
+    """List the DirecTV account's viewer profiles and which one FastChannels runs as, and
+    (POST) switch to a chosen profile. The chosen profile's ad id (partnerProfileID1) becomes
+    the Yospace `profid`; the account session is unchanged. All logic is in dtv_android."""
+    from ..scrapers import dtv_android
+
+    source = Source.query.get_or_404(source_id)
+    if source.name != 'directv':
+        return jsonify({'error': 'not a directv source'}), 400
+    cfg = dict(source.config or {})
+    if (cfg.get('auth_method') or '') != 'dtv_android':
+        return jsonify({'error': 'profiles need an Android TV sign-in', 'profiles': []}), 400
+
+    if request.method == 'GET':
+        info = dtv_android.list_profiles(cfg.get('bearer_token') or '')
+        selected = (cfg.get('dtv_android_profile_id') or '').strip() or (info.get('current_id') or '')
+        return jsonify({'profiles': info.get('profiles') or [],
+                        'selected_id': selected,
+                        'current_id': info.get('current_id') or ''})
+
+    data = request.get_json(silent=True) or request.form
+    profile_id = (data.get('profile_id') or '').strip()
+    profile_name = (data.get('profile_name') or '').strip()
+    if not profile_id:
+        return jsonify({'error': 'no profile_id'}), 400
+    result = dtv_android.select_profile(source, profile_id, profile_name)
+    return jsonify(result), (200 if result.get('ok') else 400)
+
+
+@sources_bp.route('/sources/<int:source_id>/directv-capture-adids', methods=['GET', 'POST'])
+def directv_capture_adids(source_id):
+    """GET: how many registered bridge devices still need an advertising-id capture (drives
+    the 'Capture advertising IDs' button's visibility). POST: capture the uncaptured ones
+    (newly added boxes), skipping any box that's currently playing so a stream is never
+    interrupted. All logic is in directv_dai."""
+    from ..scrapers import directv_dai
+
+    source = Source.query.get_or_404(source_id)
+    if source.name != 'directv':
+        return jsonify({'error': 'not a directv source'}), 400
+    if not directv_dai.enabled(dict(source.config or {})):
+        return jsonify({'enabled': False, 'ok': True, 'pending': 0})
+    if request.method == 'GET':
+        return jsonify({'enabled': True, 'pending': len(directv_dai.uncaptured_addresses())})
+    # Capture synchronously so the button can report the result (how many captured, and why
+    # the rest were skipped). The fast reachability probe fails a powered-off box quickly, so
+    # a handful of boxes stay well under the worker timeout.
+    counts = directv_dai.capture_registered_devices(directv_dai.uncaptured_addresses())
+    return jsonify({'enabled': True, 'ok': True, 'captured': counts['captured'],
+                    'playing': counts['playing'], 'unreachable': counts['unreachable'],
+                    'none': counts['none'], 'pending': len(directv_dai.uncaptured_addresses())})
+
