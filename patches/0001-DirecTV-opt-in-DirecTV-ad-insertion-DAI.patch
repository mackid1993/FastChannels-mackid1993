+    async function directvLogout(sourceId) {
+      if (!confirm('Log out of DirecTV? This clears the stored session. You will need to Authenticate again to play DirecTV channels.')) return;
+      const statusEl = document.getElementById(`directv-status-${sourceId}`);
+      if (statusEl) statusEl.innerHTML = '<span style="color:var(--text-muted)">Logging out...</span>';
+      try {
+        const r = await fetch(`/api/sources/${sourceId}/directv-logout`, {method: 'POST'});
+        if (!r.ok) {
+          const d = await r.json().catch(() => ({}));
+          if (statusEl) statusEl.innerHTML = `<span style="color:var(--danger)">${escapeHtml(d.error || 'Logout failed')}</span>`;
+          return;
+        }
+      } catch(e) {
+        if (statusEl) statusEl.innerHTML = '<span style="color:var(--danger)">Network error</span>';
+        return;
+      }
+      if (_directvPollTimer) clearInterval(_directvPollTimer);
+      loadSourceConfig(sourceId, 'directv');  // re-render the panel in its signed-out state
+    }
+
