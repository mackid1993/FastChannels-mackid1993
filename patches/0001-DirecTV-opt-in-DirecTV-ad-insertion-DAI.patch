+    'comscore_platform': 'PC', 'comscore_impl_type': 'b',
+    '_fw_nielsen_app_id': 'P7CFE36DB-A8D9-4801-95FE-51C29101342C',
+    'us_privacy': 'null', 'yo.po': '32', 'yo.lpa': 'true', 'yo.lp': 'true', 'yo.av': '5',
+}
