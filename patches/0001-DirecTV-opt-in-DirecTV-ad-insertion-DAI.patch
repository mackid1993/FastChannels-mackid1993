 app/scrapers/directv_dai.py      | 516 +++++++++++++++++++++++++++++++
 app/templates/admin/sources.html |   3 +
 5 files changed, 541 insertions(+), 5 deletions(-)
 create mode 100644 app/scrapers/directv_dai.py

